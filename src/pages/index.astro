---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getPublishedArticles } from "../utils/articles";
const articles = await getPublishedArticles();
---

<BaseLayout home>
  <main class="home-page" aria-label="主页内容">
    <div class="feed-heading" data-reveal>
      <h2 id="feed-title">文章</h2>
      <a href="/articles/">全部文章 <Icon name="arrow-right" size={17} /></a>
    </div>
    {articles.length ? <div class="resource-list">{articles.slice(0, 5).map(item => <ArticleCard item={item} />)}</div> : <section class="article-feed" aria-labelledby="feed-title" data-reveal>
      <div class="article-empty">
        <div class="article-empty-meta"><span><Icon name="file" size={18} /></span>公众号文章</div>
        <h3>文章正在准备中</h3>
        <p>新的文章会在这里陆续发布。</p>
        <a class="article-empty-link" href="/articles/">前往公众号文章 <Icon name="arrow-right" size={17} /></a>
      </div>
      <a class="article-enter" href="/articles/" aria-label="前往公众号文章列表"><Icon name="chevron-right" size={30} /></a>
    </section>}
  </main>
</BaseLayout>
