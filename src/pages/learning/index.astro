---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import { getCollection } from "astro:content";

const learningItems = await getCollection("learning");
const preferredOrder = [
  "books/machine-learning-watermelon-pumpkin",
  "books/opencv-python-practice",
  "books/deep-learning-from-scratch",
  "books/dive-into-deep-learning",
  "videos/d2l-v2",
  "videos/pytorch-xiaotudui"
];

const getOrderIndex = (item) => {
  const index = preferredOrder.indexOf(item.slug);
  return index === -1 ? Number.POSITIVE_INFINITY : index;
};

const sortedItems = [...learningItems].sort((a, b) => {
  const orderDiff = getOrderIndex(a) - getOrderIndex(b);
  if (orderDiff !== 0) return orderDiff;
  return b.data.date.localeCompare(a.data.date);
});

const sections = [
  { type: "book", title: "书籍" },
  { type: "video", title: "视频课程" },
  { type: "repo", title: "代码仓库" }
];
---

<BaseLayout title="学习资源归档 | Lelyetia的小站" description="Lelyetia整理的书籍、视频课程、代码仓库与学习资源。">
  <main class="content-page">
    <section class="page-heading">
      <h1>学习资源归档</h1>
      <span>收集值得保存的书籍、课程与代码仓库，按类型整理，方便随时查阅。</span>
    </section>

    {sections.map((section) => {
      const items = sortedItems.filter((item) => item.data.type === section.type);

      return (
        <section class="resource-section">
          <div class="section-title-row">
            <h2>{section.title}</h2>
          </div>

          <div class="resource-list">
            {items.map((item) => <ResourceCard item={item} />)}
          </div>
        </section>
      );
    })}
  </main>
</BaseLayout>
