  file: ["M14 3H5v18h14V8Z", "M14 3v5h5", "M8 12h8", "M8 16h5"],
  award: ["M16.5 10a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z", "m8.5 13-1 8 4.5-2 4.5 2-1-8", "M9 3h6"],
  mail: ["M3 5h18v14H3Z", "m3 6 9 7 9-7"],
  lock: ["M5 10h14v11H5Z", "M8 10V6a4 4 0 0 1 8 0v4", "M12 14v3"],
  search: ["M16 10a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z", "m15 15 6 6"],
  monitor: ["M3 4h18v12H3Z", "M8 21h8", "M12 16v5"],
  "chevron-right": ["m9 5 7 7-7 7"],
  clock: ["M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", "M12 7v5l3 2"],
  "arrow-up-right": ["M6 18 18 6", "M6 6h12v12"],
  "arrow-right": ["M4 12h16", "m14 6 6 6-6 6"],
  "arrow-down": ["M12 4v16", "m6 14 6 6 6-6"],
  "arrow-up": ["M12 20V4", "m6 10 6-6 6 6"],
  sun: ["M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z", "M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"],
  moon: ["M20.5 13.5A8.5 8.5 0 0 1 10.5 3 8.5 8.5 0 1 0 20.5 13.5Z"],
  menu: ["M4 7h16", "M4 12h16", "M4 17h16"],
