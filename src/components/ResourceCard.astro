---
import Icon from "./Icon.astro";
const { item } = Astro.props;
const href = `/learning/${item.slug}/`;
---

<article class="resource-card" data-reveal>
  <div class="resource-card-body">
    <a class="resource-title" href={href}><h3>{item.data.title}</h3><Icon name="chevron-right" size={25} /></a>
    <div class="resource-meta">
      <span><Icon name="book" size={17} />{item.data.typeLabel}</span>
      <span><Icon name="clock" size={16} /><time datetime={item.data.date}>{item.data.date}</time></span>
    </div>
    <p class="resource-author">{item.data.author}</p>
    <div class="resource-tags">{item.data.tags.map((tag) => <span>{tag}</span>)}</div>
    <div class="resource-status"><span>{item.data.status}</span><span>{item.data.depth}</span></div>
  </div>
  <a class={`resource-cover resource-cover-${item.data.type}`} href={href} aria-label={`阅读 ${item.data.title}`}>
    <img src={item.data.cover} alt={`${item.data.title} 封面`} loading="lazy" decoding="async" />
    <span class="resource-cover-overlay" aria-hidden="true"><Icon name="chevron-right" size={42} /></span>
  </a>
</article>
